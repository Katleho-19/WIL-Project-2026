@using System.Globalization
@using static PhehelloEnrollmentSchool.Models.WeekBar
@model BarChartViewModel
@{
    const double W = 560, H = 300;
    const double left = 58, right = 14, top = 18, bottom = 56;
    var plotW = W - left - right;
    var plotH = H - top - bottom;
    var slot = plotW / Math.Max(1, Model.Bars.Count);
    var barW = slot * 0.55;
    var yMax = Math.Max(1, Model.YMax);
    var step = Math.Max(1, Model.YStep);

    // Always format numbers with '.' so the SVG is valid on any server culture (e.g. en-ZA uses ',').
    string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    double Y(double v) => top + plotH - (v / yMax) * plotH;
}
<svg class="chart" viewBox="0 0 @N(W) @N(H)" role="img" aria-label="Bar chart: @Model.YTitle for each day of the week, @Model.Range">
    @* Horizontal gridlines + Y-axis tick labels *@
    @for (var v = 0; v <= yMax; v += step)
    {
        <line class="@(v == 0 ? "axis" : "grid")" x1="@N(left)" y1="@N(Y(v))" x2="@N(W - right)" y2="@N(Y(v))" />
        @:<text class="tick" x="@N(left - 8)" y="@N(Y(v) + 4)" text-anchor="end">@v</text>
    }

    @* Y axis line *@
    <line class="axis" x1="@N(left)" y1="@N(top)" x2="@N(left)" y2="@N(top + plotH)" />

    @* Bars + X-axis day labels *@
    @for (var i = 0; i < Model.Bars.Count; i++)
    {
        var b = Model.Bars[i];
        var cx = left + slot * i + slot / 2;
        var barH = (b.Count / (double)yMax) * plotH;
        if (b.Count > 0)
        {
            <rect class="bar-rect" x="@N(cx - barW / 2)" y="@N(Y(b.Count))" width="@N(barW)" height="@N(barH)" rx="2"><title>@b.Tooltip</title></rect>
            @:<text class="val" x="@N(cx)" y="@N(Y(b.Count) - 5)" text-anchor="middle">@b.Count</text>
        }
        @:<text class="tick" x="@N(cx)" y="@N(top + plotH + 18)" text-anchor="middle">@b.Label</text>
    }

    @* Axis titles *@
    @{
        @:<text class="axis-title" x="@N(left + plotW / 2)" y="@N(H - 8)" text-anchor="middle">@Model.XTitle (@Model.Range)</text>
        @:<text class="axis-title" transform="rotate(-90 14 @N(top + plotH / 2))" x="14" y="@N(top + plotH / 2)" text-anchor="middle">@Model.YTitle</text>
    }
</svg>