@model ErrorViewModel
@{ ViewData["Title"] = "Error"; Layout = "_AuthLayout"; }
<div class="card center-card"><h1>Something went wrong</h1>
<p class="subtitle" style="margin-top:10px">The request could not be completed. Please try again.</p>
@if (Model.ShowRequestId) { <p class="subtitle">Request ID: <code>@Model.RequestId</code></p> }
<p style="margin-top:18px"><a class="btn btn-brown" href="/">Back to the portal</a></p></div>
