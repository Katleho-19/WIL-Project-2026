@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; Layout = "_AuthLayout"; }
<div class="card center-card" style="text-align:left">
    <h1 style="font-weight:400">Forgot password</h1>
    <p class="subtitle" style="margin:6px 0 10px">Enter your staff email and we will send you a reset link.</p>
    <form method="post" asp-action="ForgotPassword" novalidate>
        <label class="lbl" for="Email">Email</label>
        <input class="input" asp-for="Email" autocomplete="email" />
        <span class="err" asp-validation-for="Email"></span>
        <div class="btn-row"><button class="btn btn-brown" type="submit">Send reset link</button>
        <a class="btn btn-outline" asp-action="Login">Back to login</a></div>
    </form>
</div>
