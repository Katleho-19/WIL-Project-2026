@model LoginViewModel
@{ ViewData["Title"] = "Staff Login"; Layout = "_AuthLayout"; }
<div class="auth">
    <section class="hero" aria-label="Phehello Secondary School">
        <img class="crest" src="~/img/crest.png" alt="School crest" />
        <h2>Phehello Secondary School</h2>
        <div class="kicker">ADMISSIONS &amp; ENROLMENT MANAGEMENT</div>
        <div class="motto">Perseverance is the Mother of Success</div>
    </section>
    <section class="login-pane">
        <div class="login-box">
            <h1>Staff Login</h1>
            <p class="hint">Sign in to access the authorized school admissions system.</p>

            @if (TempData["Success"] is string ok) { <div class="flash ok" role="status">@ok</div> }
            <div asp-validation-summary="ModelOnly" class="flash bad" role="alert"></div>

            <form method="post" asp-action="Login" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="tabs" role="radiogroup" aria-label="Portal">
                    <input type="radio" id="p-admin" name="Portal" value="Administrator" checked="@(Model.Portal == "Administrator")" />
                    <label for="p-admin">Administrator</label>
                    <input type="radio" id="p-clerk" name="Portal" value="Financial Clerk" checked="@(Model.Portal == "Financial Clerk")" />
                    <label for="p-clerk">Financial Clerk</label>
                </div>

                <label class="lbl" for="Email" style="margin-top:0">Username / Email</label>
                <input class="input" asp-for="Email" placeholder="Enter username or email" autocomplete="username" />
                <span class="err" asp-validation-for="Email"></span>

                <label class="lbl" for="Password">Password</label>
                <input class="input" asp-for="Password" placeholder="••••••••••" autocomplete="current-password" />
                <span class="err" asp-validation-for="Password"></span>

                <div class="row-between">
                    <label><input type="checkbox" asp-for="RememberMe" value="true" /> <strong>Remember me</strong></label>
                    <a asp-action="ForgotPassword">Forgot Password?</a>
                </div>
                <button class="btn btn-brown" type="submit">Login</button>
            </form>
            <div class="notice">Authorized administrative access only. Access is role-based for Administrator and Financial Clerk.</div>
        </div>
    </section>
</div>
