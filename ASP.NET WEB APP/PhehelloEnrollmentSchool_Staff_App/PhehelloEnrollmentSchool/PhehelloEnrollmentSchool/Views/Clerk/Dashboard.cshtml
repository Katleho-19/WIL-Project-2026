@model ClerkDashboardViewModel
@{ ViewData["Title"] = "Financial Clerk Dashboard"; ViewData["Nav"] = "Dashboard"; ViewData["SidebarSub"] = "Financial Management System"; }
<div class="page-head">
    <div><h1>Financial Clerk Dashboard</h1><p class="subtitle">Welcome back, Financial Clerk!</p></div>
    <div class="greeting"><strong>Financial Clerk</strong><span>@Model.YearLabel</span></div>
</div>
<div class="stats">
    <div class="card stat"><div class="label">Payments Awaiting Verification</div><div class="num">@Model.Awaiting</div><div class="cap">Payments awaiting verification</div></div>
    <div class="card stat"><div class="label">Verified Payments</div><div class="num">@Model.Verified</div><div class="cap">Payments verified</div></div>
    <div class="card stat"><div class="label">Total Verified Amount</div><div class="num">@Fmt.MoneyBig(Model.VerifiedAmount)</div><div class="cap">Total verified amount</div></div>
    <div class="card stat"><div class="label">Total Applications (With Payments)</div><div class="num">@Model.ApplicationsWithPayments</div><div class="cap">Applications with payments</div></div>
</div>
<div class="grid-2" style="grid-template-columns:1.25fr 1fr">
    <div class="card"><h2>Weekly Payment Trend</h2><partial name="_WeekBars" model="Model.Weeks" /></div>
    <div class="card">
        <h2>Payment Window</h2>
        <div class="sub-card"><div class="k">Academic year</div><div class="v">@Model.YearLabel</div></div>
        <div class="sub-card"><div class="k">System status</div><div class="v @(Model.Open ? "open" : "closed")">@(Model.Open ? "Open" : "Closed")</div></div>
        <a class="btn btn-gold btn-sm" asp-action="PaymentVerification">View Payments</a>
    </div>
</div>
<div class="card table-card">
    <h2 style="padding:6px 6px 0">Recent Payments</h2>
    <table class="t">
        <thead><tr><th>Application ID</th><th>Parent Name</th><th>Amount</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Recent)
        {
                <tr>
                    <td>@(p.Application?.DisplayId ?? "—")</td>
                    <td>@(p.Application?.ParentName ?? "—")</td>
                    <td>@Fmt.Money(p.Amount)</td>
                <td><span class="chip @Fmt.ChipClass(p.VerificationStatus)">@p.VerificationStatus</span></td></tr>
        }
        @if (!Model.Recent.Any()) { <tr><td colspan="4" class="empty">No payments have been submitted yet.</td></tr> }
        </tbody>
    </table>
</div>
