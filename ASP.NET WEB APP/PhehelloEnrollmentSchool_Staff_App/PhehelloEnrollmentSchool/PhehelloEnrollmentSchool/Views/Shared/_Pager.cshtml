@model Pager
<div class="pager" aria-label="Pages">
    @if (Model.Page > 1)
    {
        <a asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-Page="@(Model.Page - 1)" asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status" asp-route-Year="@Model.Filter.Year">‹</a>
    }
    else { <span>‹</span> }
    @for (var i = 1; i <= Model.PageCount; i++)
    {
        if (i == Model.Page) { <span class="cur">@i</span> }
        else { <a asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-Page="@i" asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status" asp-route-Year="@Model.Filter.Year">@i</a> }
    }
    @if (Model.Page < Model.PageCount)
    {
        <a asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-Page="@(Model.Page + 1)" asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status" asp-route-Year="@Model.Filter.Year">›</a>
    }
    else { <span>›</span> }
</div>
